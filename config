#!/usr/bin/env zsh
# shellcheck shell=bash

# Unused variables are intentional for configuration purposes, so we disable the warning for unused variables.
# shellcheck disable=SC2034

LHZSH_CONFIG_DIR=$(realpath ~/.lhzsh)
LHZSH_PLUGINS_DIR="$LHZSH_CONFIG_DIR/plugins"

export PATH="$LHZSH_CONFIG_DIR/bin:$PATH"

# Temporarily disable job notifications.
unsetopt monitor

term_greeting(){
    echo ""
    fastfetch -c "$LHZSH_CONFIG_DIR/fastfetch.jsonc"
    echo ""
    check_for_updates_in_background
}

check_for_updates_in_background() {
    if [ -d "$LHZSH_CONFIG_DIR/.git" ] && command -v git &> /dev/null; then
        (
            cd "$LHZSH_CONFIG_DIR" || exit
            local UPDATE_FILE="$LHZSH_CONFIG_DIR/data/.update_check"
            
            # Fetch remote changes at most once a day (86400 seconds)
            # This avoids delaying startup and handles offline environments gracefully
            if [[ ! -f "$UPDATE_FILE" ]] || [[ $(($(date +%s) - $(stat -c %Y "$UPDATE_FILE" 2>/dev/null || stat -f %m "$UPDATE_FILE" 2>/dev/null || echo 0))) -gt 86400 ]]; then
                # Use a 3-second timeout if the timeout command is available, and suppress errors
                if command -v timeout &> /dev/null; then
                    timeout 3 git fetch --quiet 2>/dev/null
                else
                    git fetch --quiet 2>/dev/null
                fi
                touch "$UPDATE_FILE"
            fi
            
            LOCAL=$(git rev-parse @ 2>/dev/null)
            REMOTE=$(git rev-parse @{u} 2>/dev/null)
            if [[ -n "$LOCAL" && -n "$REMOTE" && "$LOCAL" != "$REMOTE" ]]; then
                echo -e "\e[1;33m➜ A new version of LHZSH is available! Run 'lhzsh update' to upgrade.\e[0m"
            fi
        )
    fi
}

# Check if Fastfetch is available and start it in the background if the shell is interactive
if [[ -o interactive ]] && command -v fastfetch &> /dev/null; then
    term_greeting &
fi

# History
HISTFILE=$LHZSH_CONFIG_DIR/data/history
HISTSIZE=2000
SAVEHIST=2000

setopt autocd notify         # Change directory without cd, report status of background jobs immediately
setopt EXTENDED_HISTORY      # Save timestamps in history
setopt HIST_IGNORE_DUPS      # Do not record an event that was just recorded again
setopt HIST_IGNORE_SPACE     # Do not record an event starting with a space
setopt HIST_EXPIRE_DUPS_FIRST # Delete duplicates first when HISTFILE size exceeds HISTSIZE
setopt SHARE_HISTORY         # Share history between all sessions
setopt HIST_VERIFY           # Do not execute immediately upon history expansion

bindkey -e

zstyle :compinstall filename "$LHZSH_CONFIG_DIR/data/completions"

autoload -Uz compinit && compinit

setopt CORRECT               # Tippfehler-Korrektur vorschlagen

setopt MENU_COMPLETE         # erstes Match sofort einsetzen
setopt AUTO_LIST             # Optionen automatisch listen

zstyle ':completion:*' menu select          # navigierbare Completion-Liste
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'  # case-insensitive
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"  # Farben in Completion

# Advanced Autocompletion styling
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{blue}-- %d --%f'
zstyle ':completion:*:messages' format '%F{purple}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{red}-- no matches found --%f'

setopt INTERACTIVE_COMMENTS


for f in "$LHZSH_PLUGINS_DIR"/**/*.plugin.zsh(N); do
    source "$f"
done

# Enable Custom Theme
source "$LHZSH_CONFIG_DIR/theme.zsh"

# Line Editing Keybindings (Ctrl+Arrows, Ctrl+Backspace, Ctrl+Delete)
bindkey '^[[1;5D' backward-word      # Ctrl+Left
bindkey '^[[1;5C' forward-word       # Ctrl+Right
bindkey '^H' backward-kill-word      # Ctrl+Backspace
bindkey '^W' backward-kill-word      # Ctrl+W
bindkey '^[[3;5~' kill-word          # Ctrl+Delete
bindkey '^[[Z' reverse-menu-complete # Shift-Tab

# History Substring Search Keybindings
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

source "$LHZSH_CONFIG_DIR/alias.zsh"
source "$LHZSH_CONFIG_DIR/fixenv.zsh"

# Initialize zoxide if installed
if command -v zoxide &> /dev/null; then
    export _ZO_DATA_DIR="$LHZSH_CONFIG_DIR/data/zoxide"
    eval "$(zoxide init zsh --cmd cd)"
fi

# Initialize direnv if installed
# (Direnv safely ignores .envrc files until you explicitly run 'direnv allow')
if command -v direnv &> /dev/null; then
    eval "$(direnv hook zsh)"
fi

# Wait for background jobs to finish before showing the prompt
wait

setopt monitor

# LHZSH Management Shell Wrapper
# This wraps the bin/lhzsh command to allow 'reload' to execute in the current shell context
lhzsh() {
    if [[ "$1" == "reload" ]]; then
        echo "Reloading Zsh session..."
        exec zsh
    else
        command lhzsh "$@"
    fi
}

# Clean up environment and functions
unset -f term_greeting